# Runtime (xCloud sets PORT; HOST should stay 0.0.0.0 in production)
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Public site origin (canonical / OG / EmDash) — use your live domain
SITE_URL=https://mpx.darkodev.zone
PUBLIC_SITE_URL=https://mpx.darkodev.zone

# Google Analytics 4. Leave blank. Do not add GTM, GA4, or HubSpot IDs yet.
PUBLIC_GA_MEASUREMENT_ID=

# EmDash
# Generate a fresh key for production; do not reuse a local/dev key from git history.
EMDASH_ENCRYPTION_KEY=
EMDASH_SITE_URL=https://mpx.darkodev.zone

# Contact form → ZeptoMail (Zoho transactional email)
# Create a Mail Agent + Send Mail Token in ZeptoMail, verify your from-domain.
# Paste the token only (or the full "Zoho-enczapikey …" value — both work).
ZEPTOMAIL_API_KEY=
# Optional override (defaults to https://api.zeptomail.com/v1.1/email)
# EU example: https://api.zeptomail.eu/v1.1/email
# CPaaS example: https://cpaas.zoho.com/v1.1/email
ZEPTOMAIL_API_URL=
ZEPTOMAIL_FROM_ADDRESS=website@metapixels.co.uk
ZEPTOMAIL_FROM_NAME=MetaPixels

# Inbox that receives website enquiries
CONTACT_TO_ADDRESS=info@metapixels.co.uk
CONTACT_TO_NAME=MetaPixels
# Silent copies — comma-separated (separate ZeptoMail sends).
# Defaults to info@metapixels.co.uk when blank.
CONTACT_BCC_ADDRESS=

# Cloudflare Turnstile (contact form spam protection)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# First-party analytics (clicks + form submissions → JSONL + report API)
# Required to read GET /api/analytics/report (Authorization: Bearer …)
ANALYTICS_API_KEY=
# Optional log directory (default: ./data/analytics)
# ANALYTICS_LOG_DIR=
# Email on each contact/social click (default on; set false to disable)
ANALYTICS_CLICK_ALERTS=true
# Who receives click alerts (defaults to info@metapixels.co.uk)
ANALYTICS_ALERT_EMAIL=
