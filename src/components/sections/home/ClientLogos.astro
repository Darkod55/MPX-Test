---
import threeCounties from "../../../assets/mpx/metapixels-client-logo-white-three-counties.svg?url";
import learnChess from "../../../assets/mpx/metapixels-client-logo-white-learn-chess.svg?url";
import homeStatements from "../../../assets/mpx/metapixels-client-logo-white-home-statements.svg?url";
import jfa from "../../../assets/mpx/metapixels-client-logo-white-jfa.svg?url";
import jaBrooks from "../../../assets/mpx/metapixels-client-logo-white-ja-brooks.svg?url";
import seTennis from "../../../assets/mpx/metapixels-client-logo-white-se-tennis.svg?url";
import gameon from "../../../assets/mpx/metapixels-client-logo-white-gameon-daily.svg?url";
import drBodani from "../../../assets/mpx/metapixels-client-logo-white-dr-bodani.svg?url";
import cyberone from "../../../assets/mpx/metapixels-client-logo-white-cyberone.svg?url";

const logos = [
	{ src: threeCounties, alt: "MetaPixels client logo white Three Counties" },
	{ src: learnChess, alt: "MetaPixels client logo white Learn Chess Academy" },
	{ src: homeStatements, alt: "MetaPixels client logo white Home Statements" },
	{ src: jfa, alt: "MetaPixels client logo white JF Automotive" },
	{ src: jaBrooks, alt: "MetaPixels client logo white JA Brooks" },
	{ src: seTennis, alt: "MetaPixels client logo white SE Tennis" },
	{ src: gameon, alt: "MetaPixels client logo white Gameon Daily" },
	{ src: drBodani, alt: "MetaPixels client logo white Dr Bodani" },
	{ src: cyberone, alt: "MetaPixels client logo white CyberOne" },
];
---

<section class="client-logos" aria-label="Clients">
	{/* Native .container — scoped styles on the list must not override it */}
	<div class="container">
		<ul class="client-logos__list">
			{
				logos.map((logo) => (
					<li class="client-logos__item">
						<img src={logo.src} alt={logo.alt} width="220" height="72" />
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.client-logos {
		background: var(--color-primary);
		padding-block: 2.5rem 3.5rem;
	}

	.client-logos__list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: center;
		justify-items: center;
		column-gap: 3rem;
		row-gap: 2.75rem;
		width: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.client-logos__item {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		margin: 0;
		text-align: center;
	}

	.client-logos__item img {
		display: block;
		width: auto;
		max-width: min(100%, 240px);
		max-height: 80px;
		margin-inline: auto;
		object-fit: contain;
	}

	@media (max-width: 639px) {
		.client-logos__list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: 1.5rem;
			row-gap: 2rem;
		}

		.client-logos__item img {
			max-width: min(100%, 180px);
			max-height: 64px;
		}
	}
</style>
