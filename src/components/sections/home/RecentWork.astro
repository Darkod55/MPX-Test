---
import { Image } from "astro:assets";
import { homeRecentWork } from "../../../content/home";
---

<section class="recent-work" id="recent-work">
	<div class="container recent-work__inner">
		<h2>Recent work.</h2>
		<ul>
			{
				homeRecentWork.map((item) => (
					<li>
						<a href={item.href}>
							<Image
								src={item.image}
								alt={item.imageAlt}
								width={640}
								height={400}
								widths={[320, 480, 640]}
								sizes="(min-width: 900px) 30vw, 100vw"
								loading="lazy"
							/>
							<h3>{item.title}</h3>
							<p>{item.summary}</p>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.recent-work {
		padding-block: clamp(3rem, 6vw, 5rem);
		background: var(--color-primary);
		color: var(--color-white);
	}

	.recent-work h2 {
		margin: 0;
		color: var(--color-white);
		text-transform: none;
	}

	.recent-work ul {
		display: grid;
		gap: 2.5rem 2rem;
		margin: 2.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 800px) {
		.recent-work ul {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 2.75rem 2.5rem;
		}
	}

	.recent-work a {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		color: inherit;
		text-decoration: none;
	}

	.recent-work img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 1rem;
	}

	.recent-work h3 {
		margin: 0.25rem 0 0;
		color: var(--color-white);
		text-transform: none;
	}

	.recent-work p {
		margin: 0;
		color: var(--color-text-on-dark);
	}
</style>
