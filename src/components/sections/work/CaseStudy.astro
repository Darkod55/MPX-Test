---
import { Image } from "astro:assets";
import type { CaseStudy } from "../../../data/work";

interface Props {
	study: CaseStudy;
}

const { study } = Astro.props;
---

<article class="case-study" id={study.id}>
	<div class="container case-study__inner">
		<header class="case-study__header">
			<h2>{study.title}</h2>
			<p>{study.summary}</p>
		</header>

		<dl class="case-study__facts">
			<div>
				<dt>Business type</dt>
				<dd>{study.businessType}</dd>
			</div>
			<div>
				<dt>Website type</dt>
				<dd>{study.websiteType}</dd>
			</div>
			<div>
				<dt>Live site</dt>
				<dd>
					<a href={study.siteHref} target="_blank" rel="noopener noreferrer">
						{study.siteLabel}
					</a>
				</dd>
			</div>
			<div>
				<dt>Services used</dt>
				<dd>
					<ul>
						{
							study.services.map((item) => (
								<li>
									<a href={item.href}>{item.label}</a>
								</li>
							))
						}
					</ul>
				</dd>
			</div>
		</dl>

		<div class="case-study__body">
			{study.body.map((paragraph) => <p>{paragraph}</p>)}
		</div>

		<Image
			src={study.image}
			alt={study.imageAlt}
			class="case-study__image"
			widths={[480, 768, 1200]}
			sizes="(min-width: 1024px) 960px, 100vw"
			loading="lazy"
		/>

		<p class="case-study__pull">
			<strong>{study.pullTitle}</strong> {study.pullBody}
		</p>

		<h3>Outputs</h3>
		<ul class="case-study__outputs">
			{study.outputs.map((item) => <li>{item}</li>)}
		</ul>
	</div>
</article>

<style>
	.case-study {
		padding-block: clamp(3rem, 6vw, 5rem);
		background: var(--color-white);
		color: var(--color-text);
	}

	.case-study:nth-of-type(even) {
		background: var(--color-grey-50);
	}

	.case-study__inner {
		display: grid;
		gap: 1.25rem;
	}

	.case-study h2,
	.case-study h3 {
		text-transform: none;
		letter-spacing: 0;
	}

	.case-study__facts {
		display: grid;
		gap: 0.75rem 1.5rem;
		margin: 0;
	}

	@media (min-width: 768px) {
		.case-study__facts {
			grid-template-columns: 1fr 1fr;
		}
	}

	.case-study__facts div {
		margin: 0;
	}

	.case-study__facts dt {
		font-weight: 700;
	}

	.case-study__facts dd,
	.case-study__facts ul {
		margin: 0.25rem 0 0;
	}

	.case-study__facts ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.75rem;
	}

	.case-study__image {
		width: 100%;
		height: auto;
		border-radius: 1.5rem;
	}

	.case-study__outputs {
		margin: 0;
		padding-left: 1.1rem;
		list-style: disc;
	}

	.case-study__outputs li + li {
		margin-top: 0.5rem;
	}
</style>
