---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import ContactSection from "../components/sections/contact/ContactSection.astro";
import {
	contactFaqs,
	contactHero,
	contactMeta,
	contactReasons,
} from "../content/contact";
import {
	breadcrumbListJsonLd,
	faqPageJsonLd,
	resolveSiteOrigin,
} from "../utils/seo";

const origin = resolveSiteOrigin({
	configured: Astro.site,
	requestOrigin: Astro.url.origin,
	headers: Astro.request.headers,
});

const contactJsonLd = [
	breadcrumbListJsonLd(origin, [
		{ name: "Home", path: "/" },
		{ name: "Contact", path: "/contact" },
	]),
	faqPageJsonLd(origin, "/contact", [...contactFaqs]),
];
---

<BaseLayout
	title={contactMeta.title}
	description={contactMeta.description}
	canonicalPath="/contact"
	pageType="ContactPage"
	lcpImage={contactHero.image}
	jsonLd={contactJsonLd}
>
	<Hero {...contactHero} />
	<section class="contact-reasons">
		<div class="container contact-reasons__inner">
			<h2>Why would you get in touch with us?</h2>
			<p>
				With our expertise in web development, design, branding and marketing, there are many reasons to work with us.
			</p>
			<ol>
				{contactReasons.map((reason) => <li>{reason}</li>)}
			</ol>
			<h3>FAQs</h3>
			{
				contactFaqs.map((faq) => (
					<>
						<h4>{faq.question}</h4>
						<p>{faq.answer}</p>
					</>
				))
			}
		</div>
	</section>
	<ContactSection />
</BaseLayout>

<style>
	.contact-reasons {
		padding-block: clamp(3rem, 6vw, 5rem);
		background: var(--color-white);
		color: var(--color-text);
	}

	.contact-reasons__inner {
		display: grid;
		gap: 1rem;
		max-width: 760px;
	}

	.contact-reasons h2,
	.contact-reasons h3,
	.contact-reasons h4 {
		text-transform: none;
	}

	.contact-reasons ol {
		margin: 0;
		padding-left: 1.25rem;
	}

	.contact-reasons li + li {
		margin-top: 0.4rem;
	}
</style>
