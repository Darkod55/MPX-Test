---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import IntroStatement from "../components/sections/home/IntroStatement.astro";
import BetterUnderstanding from "../components/sections/home/BetterUnderstanding.astro";
import Beliefs from "../components/sections/home/Beliefs.astro";
import HowWeHelp from "../components/sections/home/HowWeHelp.astro";
import MoreThanAnAgency from "../components/sections/home/MoreThanAnAgency.astro";
import RecentWork from "../components/sections/home/RecentWork.astro";
import ClientLogos from "../components/sections/home/ClientLogos.astro";
import CtaSection from "../components/sections/CtaSection.astro";
import {
	homeBeliefs,
	homeBetterUnderstanding,
	homeCtaSection,
	homeHero,
	homeHowWeHelp,
	homeIntro,
	homeMeta,
	homeMoreThanAnAgency,
} from "../content/home";
import { breadcrumbListJsonLd, resolveSiteOrigin } from "../utils/seo";

const origin = resolveSiteOrigin({
	configured: Astro.site,
	requestOrigin: Astro.url.origin,
	headers: Astro.request.headers,
});

const homeJsonLd = breadcrumbListJsonLd(origin, [
	{ name: "Home", path: "/" },
]);
---

<BaseLayout
	title={homeMeta.title}
	description={homeMeta.description}
	canonicalPath={homeMeta.canonicalPath}
	lcpImage={homeHero.image}
	lcpVariant="home"
	jsonLd={homeJsonLd}
>
	<Hero {...homeHero} />
	<IntroStatement {...homeIntro} />
	<BetterUnderstanding {...homeBetterUnderstanding} />
	<Beliefs {...homeBeliefs} beforeSplit />
	<HowWeHelp {...homeHowWeHelp} />
	<MoreThanAnAgency {...homeMoreThanAnAgency} />
	<RecentWork />
	<ClientLogos />
	<CtaSection {...homeCtaSection} />
</BaseLayout>
